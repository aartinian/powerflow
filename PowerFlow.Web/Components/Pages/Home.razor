@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<PageTitle>PowerFlow — Solver</PageTitle>

<!-- ── Toolbar ─────────────────────────────────────────── -->
<div class="pf-toolbar">
    <!-- Sample cases (left) -->
    <div class="pf-toolbar-samples">
        <span class="pf-samples-label">Sample</span>
        @foreach (var c in Cases)
        {
            <button class="pf-sample-btn @(fileName == c.File + ".m" ? "active" : "")"
                    @onclick="() => LoadSample(c.File)"
                    disabled="@busy"
                    title="@c.Buses buses · @c.Branches branches · @c.Gens generators">
                @c.Label
                <span class="pf-sample-meta">@c.Buses bus</span>
            </button>
        }
    </div>

    <div class="pf-toolbar-sep" aria-hidden="true"></div>

    <!-- File + Solve (right) -->
    <label class="pf-file-btn" title="Choose a MATPOWER .m file">
        <InputFile OnChange="HandleFile" accept=".m" />
        @if (fileName is null)
        {
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span>Choose .m file</span>
        }
        else
        {
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span class="pf-file-chosen">@fileName</span>
        }
    </label>

    <button class="pf-solve" @onclick="Solve"
            disabled="@(fileContent is null || busy)">
        @if (busy)
        {
            <span class="pf-spinner" aria-hidden="true"></span>
            <span>Solving…</span>
        }
        else
        {
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            <span>Run solver</span>
        }
    </button>
</div>

<!-- ── Solver options ─────────────────────────────────── -->
<div class="pf-options pf-panel mb-3">
    <div class="pf-options-row">
        <span class="pf-options-label">Mode</span>
        <div class="pf-segmented" role="radiogroup" aria-label="Solver mode">
            <button class="pf-seg @(mode == "ac" ? "active" : "")"
                    @onclick='() => mode = "ac"'
                    disabled="@busy"
                    title="Polar-form Newton-Raphson with sparse LU">AC</button>
            <button class="pf-seg @(mode == "dc" ? "active" : "")"
                    @onclick='() => mode = "dc"'
                    disabled="@busy"
                    title="Linearised DC power flow (one sparse-LU step, lossless)">DC</button>
        </div>

        @if (mode == "ac")
        {
            <span class="pf-options-sep" aria-hidden="true"></span>
            <span class="pf-options-label">Solver</span>
            <label class="pf-check" title="Override Vm/Va from the bus data with Vm=1 pu, Va=0°">
                <input type="checkbox" @bind="optFlatStart" disabled="@busy" />
                <span>Flat start</span>
            </label>
            <label class="pf-check" title="Enforce generator Q-limits via PV→PQ switching (outer loop)">
                <input type="checkbox" @bind="optEnforceLimits" disabled="@busy" />
                <span>Q-limits</span>
            </label>
            <label class="pf-check" title="Spread real-power imbalance λ across generators by Pmax">
                <input type="checkbox" @bind="optDistSlack" disabled="@busy" />
                <span>Distributed slack</span>
            </label>
            <label class="pf-check" title="Seed AC voltage angles from a DC pre-solve">
                <input type="checkbox" @bind="optWarmStart" disabled="@busy" />
                <span>DC warm-start</span>
            </label>
        }
    </div>

    @if (mode == "ac")
    {
        <div class="pf-options-row">
            <span class="pf-options-label">Tolerance</span>
            <input type="text" class="pf-num-input" @bind="optToleranceStr"
                   disabled="@busy" placeholder="1e-6"
                   title="Convergence criterion in pu (max(|ΔP|,|ΔQ|))" />
            <span class="pf-options-sep" aria-hidden="true"></span>
            <span class="pf-options-label">Max iter</span>
            <input type="number" class="pf-num-input" @bind="optMaxIter"
                   disabled="@busy" min="1" max="500"
                   title="Cap on inner Newton-Raphson iterations per outer pass" />
        </div>
    }
</div>

@if (error is not null)
{
    <div class="pf-banner pf-fail mb-3">@error</div>
}

@if (validationErrors.Count > 0 || validationWarnings.Count > 0)
{
    <div class="pf-panel pf-violations mb-3">
        <div class="pf-section-head @(validationErrors.Count > 0 ? "pf-section-head-fail" : "pf-section-head-warn")">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span class="pf-section-title">
                @if (validationErrors.Count > 0)
                {
                    <text>Validation Failed</text>
                }
                else
                {
                    <text>Validation Warnings</text>
                }
            </span>
            <span class="pf-section-meta">
                @validationErrors.Count error@(validationErrors.Count == 1 ? "" : "s")
                @if (validationWarnings.Count > 0)
                {
                    <text>&thinsp;·&thinsp; @validationWarnings.Count warning@(validationWarnings.Count == 1 ? "" : "s")</text>
                }
            </span>
        </div>
        <div class="pf-tbl-wrap" style="max-height:240px">
            <table class="table table-sm pf-tbl mb-0">
                <thead><tr>
                    <th style="width:5.5rem">Severity</th>
                    <th style="width:14rem">Code</th>
                    <th>Message</th>
                </tr></thead>
                <tbody>
                    @foreach (var v in validationErrors)
                    {
                        <tr>
                            <td><span class="pf-vbadge pf-vbadge-under">Error</span></td>
                            <td class="pf-cell-muted"><code>@v.Code</code></td>
                            <td>@v.Message</td>
                        </tr>
                    }
                    @foreach (var v in validationWarnings)
                    {
                        <tr>
                            <td><span class="pf-vbadge pf-vbadge-over">Warning</span></td>
                            <td class="pf-cell-muted"><code>@v.Code</code></td>
                            <td>@v.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ── Idle state ──────────────────────────────────────── -->
@if (!busy && logLines.Count == 0 && result is null && dcResult is null)
{
    <div class="pf-empty">
        <div class="pf-empty-inner">
            <div class="pf-empty-glyph" aria-hidden="true">
                @* Mirror the brand mark — three-node triangle, but larger and softer. *@
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.4"
                     stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="4" y2="19" />
                    <line x1="12" y1="5" x2="20" y2="19" />
                    <line x1="4" y1="19" x2="20" y2="19" />
                    <circle cx="12" cy="5"  r="2.4" fill="currentColor" stroke="none" />
                    <circle cx="4"  cy="19" r="2.4" fill="currentColor" stroke="none" />
                    <circle cx="20" cy="19" r="2.4" fill="currentColor" stroke="none" />
                </svg>
            </div>
            <h2 class="pf-empty-title">Ready to solve</h2>
            <p class="pf-empty-sub">
                Pick a sample case above, or upload a MATPOWER <code>.m</code> file.
            </p>
            <div class="pf-empty-chips" aria-label="Capabilities">
                <span class="pf-empty-chip">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    AC Newton-Raphson + DC linearised
                </span>
                <span class="pf-empty-chip">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Q-limits · Distributed slack · DC warm-start
                </span>
                <span class="pf-empty-chip">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Sparse LU (CSparse) · 194 tests
                </span>
                <span class="pf-empty-chip">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Validated on IEEE 14 / 30 / 57 / 118 / 300
                </span>
            </div>
        </div>
    </div>
}

<!-- ── Workspace ───────────────────────────────────────── -->
@if (busy || logLines.Count > 0 || result is not null || dcResult is not null)
{
    <!-- ── Solver log (top drawer) ────────────────────── -->
    <div class="pf-log-panel pf-panel mb-3">
        <div class="pf-log-header" @onclick="ToggleLog" role="button" tabindex="0">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
            </svg>
            <span class="pf-log-label">Solver Log</span>
            <span class="pf-log-count">@logLines.Count lines</span>
            @if (logCollapsed && logLines.Count > 0)
            {
                <span class="pf-log-preview">@logLines[^1].Text</span>
            }
            <svg class="pf-chevron @(logCollapsed ? "" : "pf-chevron-open")"
                 width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </div>
        @if (!logCollapsed)
        {
            <div class="pf-log" @ref="logPanel">
                @if (busy && logLines.Count == 0)
                {
                    <div class="pf-log-waiting">Waiting for solver…</div>
                }
                @foreach (var (text, isWarn) in logLines)
                {
                    <div class="@(isWarn ? "pf-warn" : "")">@text</div>
                }
            </div>
        }
    </div>

    @if (busy && result is null && dcResult is null)
    {
        <div class="pf-solving-placeholder mb-3">
            <span class="pf-spinner pf-spinner-lg" aria-hidden="true"></span>
            <span>@(mode == "dc" ? "Running DC power flow…" : "Running Newton-Raphson…")</span>
        </div>
    }

    @if (result is not null && network is not null)
    {
        <!-- ── Status card (hero result) ──────────────────── -->
        @* Confident, data-forward layout: state pill on the left, big tabular     *@
        @* iteration count as the headline, supporting metrics on the right.       *@
        <div class="pf-hero @(result.Converged ? "pf-hero-ok" : "pf-hero-fail") mb-3">
            <div class="pf-hero-row">
                <div class="pf-hero-pill">
                    @if (result.Converged)
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        <span>Converged</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                        <span>Did not converge</span>
                    }
                </div>
                <div class="pf-hero-headline">
                    <span class="pf-hero-num">@result.Iterations</span>
                    <span class="pf-hero-num-lbl">iteration@(result.Iterations == 1 ? "" : "s")</span>
                    @if (result.OuterIterations > 1)
                    {
                        <span class="pf-hero-divider"></span>
                        <span class="pf-hero-num pf-hero-num-sm">@result.OuterIterations</span>
                        <span class="pf-hero-num-lbl">outer pass@(result.OuterIterations == 1 ? "" : "es")</span>
                    }
                </div>
                <div class="pf-hero-stats">
                    <div class="pf-hero-stat">
                        <span class="pf-hero-stat-lbl">max |f|</span>
                        <code class="pf-hero-stat-val">@result.MaxMismatch.ToString("e2") pu</code>
                    </div>
                    <div class="pf-hero-stat">
                        <span class="pf-hero-stat-lbl">network</span>
                        <span class="pf-hero-stat-val">@network.Buses.Count·@result.BranchFlows.Count·@network.Generators.Count</span>
                    </div>
                </div>
            </div>
            @if (optDistSlack)
            {
                var lambdaMw = result.Lambda * network.BaseMva;
                <div class="pf-hero-extra">
                    <span class="pf-pill pf-pill-accent" title="Distributed-slack imbalance shared across all generators by Pmax participation">
                        λ = @($"{lambdaMw:+0.000;-0.000;0.000} MW")
                    </span>
                    <span class="pf-cell-muted">@($"{result.Lambda:+0.00000;-0.00000;0.00000} pu on {network.BaseMva:F0} MVA base")</span>
                </div>
            }
        </div>

        @if (result.VoltageViolations.Count > 0)
        {
            <div class="pf-panel pf-violations mb-3">
                <div class="pf-section-head pf-section-head-warn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    <span class="pf-section-title">Voltage Violations</span>
                    <span class="pf-section-meta">@result.VoltageViolations.Count bus@(result.VoltageViolations.Count == 1 ? "" : "es") outside limits</span>
                </div>
                <div class="pf-tbl-wrap" style="max-height:220px">
                    <table class="table table-sm pf-tbl mb-0">
                        <thead><tr>
                            <th>Bus</th>
                            <th class="text-end">Voltage (pu)</th>
                            <th>Type</th>
                            <th>Allowed range</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var v in result.VoltageViolations)
                            {
                                <tr>
                                    <td>@v.BusId</td>
                                    <td class="text-end pf-cell-warn">@v.Vm.ToString("F4")</td>
                                    <td>
                                        <span class="pf-vbadge @(v.IsOverVoltage ? "pf-vbadge-over" : "pf-vbadge-under")">
                                            @(v.IsOverVoltage ? "Over" : "Under")
                                        </span>
                                    </td>
                                    <td class="pf-cell-muted">@v.Vmin.ToString("F3") – @v.Vmax.ToString("F3") pu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ── Summary metrics ────────────────────────── -->
        @if (Metrics is { } m)
        {
            <div class="pf-metrics pf-panel mb-3">
                <div class="pf-metric">
                    <div class="pf-metric-row">
                        <span class="pf-metric-num">@Fmt(m.GenMW)</span>
                        <span class="pf-metric-unit">MW</span>
                    </div>
                    <div class="pf-metric-lbl">Generation</div>
                </div>
                <div class="pf-metric">
                    <div class="pf-metric-row">
                        <span class="pf-metric-num">@Fmt(m.LoadMW)</span>
                        <span class="pf-metric-unit">MW</span>
                    </div>
                    <div class="pf-metric-lbl">Load</div>
                </div>
                <div class="pf-metric">
                    <div class="pf-metric-row">
                        <span class="pf-metric-num">@Fmt(m.LossMW)</span>
                        <span class="pf-metric-unit">MW</span>
                    </div>
                    <div class="pf-metric-lbl">Losses</div>
                </div>
                <div class="pf-metric @VoltageRangeClass(m.VmMin, m.VmMax)">
                    <div class="pf-metric-row">
                        <span class="pf-metric-num pf-metric-num-sm">
                            @m.VmMin.ToString("F3")&thinsp;–&thinsp;@m.VmMax.ToString("F3")
                        </span>
                        <span class="pf-metric-unit">pu</span>
                    </div>
                    <div class="pf-metric-lbl">Voltage range</div>
                </div>
                <div class="pf-metric @MaxLoadClass(m.MaxLoadPct)">
                    <div class="pf-metric-row">
                        <span class="pf-metric-num">@(double.IsNaN(m.MaxLoadPct) ? "—" : m.MaxLoadPct.ToString("F1"))</span>
                        <span class="pf-metric-unit">@(double.IsNaN(m.MaxLoadPct) ? "" : "%")</span>
                    </div>
                    <div class="pf-metric-lbl">Max loading</div>
                </div>
                <div class="pf-metric">
                    <div class="pf-metric-buses">
                        <span class="pf-bus-chip pf-bus-slack">@m.NSlack&thinsp;Sl</span>
                        <span class="pf-bus-chip pf-bus-pv">@m.NPv&thinsp;PV</span>
                        <span class="pf-bus-chip pf-bus-pq">@m.NPq&thinsp;PQ</span>
                    </div>
                    <div class="pf-metric-lbl">Buses</div>
                </div>
            </div>
        }

        <!-- ── Data tables ────────────────────────────── -->
        <div class="pf-panel mb-3">
            <div class="pf-tabs">
                <button class="pf-tab @(tab == "buses" ? "active" : "")"
                        @onclick='() => tab = "buses"'>
                    Buses <span class="pf-tab-count">@network.Buses.Count</span>
                </button>
                <button class="pf-tab @(tab == "branches" ? "active" : "")"
                        @onclick='() => tab = "branches"'>
                    Branches <span class="pf-tab-count">@result.BranchFlows.Count</span>
                </button>
                <button class="pf-tab @(tab == "generators" ? "active" : "")"
                        @onclick='() => tab = "generators"'>
                    Generators <span class="pf-tab-count">@network.Generators.Count</span>
                </button>
            </div>

            <div class="pf-tbl-wrap">
                @if (tab == "buses")
                {
                    <table class="table table-sm pf-tbl mb-0">
                        <thead><tr>
                            <th>Bus</th>
                            <th class="text-end">Vm (pu)</th>
                            <th class="text-end">Va (°)</th>
                            <th class="text-end">Pg (MW)</th>
                            <th class="text-end">Qg (MVAr)</th>
                            <th class="text-end">Pd (MW)</th>
                            <th class="text-end">Qd (MVAr)</th>
                        </tr></thead>
                        <tbody>
                            @for (int i = 0; i < network.Buses.Count; i++)
                            {
                                var bus = network.Buses[i];
                                var vm = result.Vm[i];
                                <tr>
                                    <td>@bus.Id</td>
                                    <td class="text-end @VmClass(vm)">@vm.ToString("F4")</td>
                                    <td class="text-end">@result.Va[i].ToString("F3")</td>
                                    <td class="text-end">@Fmt(result.Pg[i] * network.BaseMva)</td>
                                    <td class="text-end">@Fmt(result.Qg[i] * network.BaseMva)</td>
                                    <td class="text-end">@bus.Pd.ToString("F1")</td>
                                    <td class="text-end">@bus.Qd.ToString("F1")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (tab == "branches")
                {
                    <table class="table table-sm pf-tbl mb-0">
                        <thead><tr>
                            <th>From</th>
                            <th>To</th>
                            <th class="text-end">P_ij (MW)</th>
                            <th class="text-end">Q_ij (MVAr)</th>
                            <th class="text-end">P_ji (MW)</th>
                            <th class="text-end">Q_ji (MVAr)</th>
                            <th class="text-end">Loss (MW)</th>
                            <th class="text-end">Loading</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var bf in result.BranchFlows)
                            {
                                var mva = network.BaseMva;
                                var pct = bf.LoadingPct;
                                <tr>
                                    <td>@bf.FromBusId</td>
                                    <td>@bf.ToBusId</td>
                                    <td class="text-end">@Fmt(bf.Pij * mva)</td>
                                    <td class="text-end">@Fmt(bf.Qij * mva)</td>
                                    <td class="text-end">@Fmt(bf.Pji * mva)</td>
                                    <td class="text-end">@Fmt(bf.Qji * mva)</td>
                                    <td class="text-end">@Fmt((bf.Pij + bf.Pji) * mva)</td>
                                    <td class="text-end @LoadClass(pct)">
                                        @(double.IsNaN(pct) ? "—" : pct.ToString("F1") + "%")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    // Pair input generators with solver-side GeneratorResults by index alignment.
                    // Core builds one GeneratorResult per in-service generator in input order, so
                    // walking the in-service subset of network.Generators in order matches.
                    // This works correctly even with multiple generators on the same bus.
                    var inSvcResults = result.Generators;
                    int gri = 0;
                    <table class="table table-sm pf-tbl mb-0">
                        <thead><tr>
                            <th>#</th>
                            <th>Bus</th>
                            <th class="text-end">Vg (pu)</th>
                            <th class="text-end">Pg (MW)</th>
                            @if (optDistSlack)
                            {
                                <th class="text-end" title="Distributed-slack correction = α_i · λ · BaseMVA">Δ (MW)</th>
                            }
                            <th class="text-end">Pg_min</th>
                            <th class="text-end">Pg_max</th>
                            <th class="text-end">Qg (MVAr)</th>
                            <th class="text-end">Qg_min</th>
                            <th class="text-end">Qg_max</th>
                            <th>Q-limit</th>
                            <th>Status</th>
                        </tr></thead>
                        <tbody>
                            @for (int i = 0; i < network.Generators.Count; i++)
                            {
                                var gen = network.Generators[i];
                                var busIdx = network.IndexOf(gen.BusId);
                                GeneratorResult? gr = null;
                                if (gen.IsInService && gri < inSvcResults.Count)
                                {
                                    gr = inSvcResults[gri];
                                    gri++;
                                }
                                <tr>
                                    <td class="pf-cell-muted">@(i + 1)</td>
                                    <td>@gen.BusId</td>
                                    <td class="text-end">@gen.Vg.ToString("F4")</td>
                                    <td class="text-end">@Fmt(gr is null ? gen.Pg : gr.Pg)</td>
                                    @if (optDistSlack)
                                    {
                                        var delta = gr is null ? 0.0 : gr.Pg - gen.Pg;
                                        <td class="text-end @(Math.Abs(delta) >= 0.05 ? "" : "pf-cell-muted")">
                                            @(delta >= 0 ? $"+{delta:F3}" : $"{delta:F3}")
                                        </td>
                                    }
                                    <td class="text-end pf-cell-muted">@Fmt(gen.Pmin)</td>
                                    <td class="text-end pf-cell-muted">@Fmt(gen.Pmax)</td>
                                    <td class="text-end">@Fmt(result.Qg[busIdx] * network.BaseMva)</td>
                                    <td class="text-end pf-cell-muted">@Fmt(gen.Qmin)</td>
                                    <td class="text-end pf-cell-muted">@Fmt(gen.Qmax)</td>
                                    <td>
                                        @if (gr is { IsAtQmax: true })
                                        {
                                            <span class="pf-vbadge pf-vbadge-over" title="PV bus switched to PQ — reactive output pinned at Qmax">Qmax</span>
                                        }
                                        else if (gr is { IsAtQmin: true })
                                        {
                                            <span class="pf-vbadge pf-vbadge-over" title="PV bus switched to PQ — reactive output pinned at Qmin">Qmin</span>
                                        }
                                    </td>
                                    <td>
                                        @if (gen.IsInService)
                                        {
                                            <span class="pf-badge pf-badge-ok">On</span>
                                        }
                                        else
                                        {
                                            <span class="pf-badge pf-badge-off">Off</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @if (dcResult is not null && network is not null)
    {
        <!-- DC: always converges in one LU step. No Vm, no Q, no losses (model is lossless). -->
        <div class="pf-hero pf-hero-ok pf-hero-dc mb-3">
            <div class="pf-hero-row">
                <div class="pf-hero-pill">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>DC solved</span>
                </div>
                <div class="pf-hero-headline">
                    <span class="pf-hero-num">1</span>
                    <span class="pf-hero-num-lbl">LU step</span>
                    <span class="pf-hero-divider"></span>
                    <span class="pf-hero-num-lbl pf-hero-num-lbl-em">linearised B′θ = P</span>
                </div>
                <div class="pf-hero-stats">
                    <div class="pf-hero-stat">
                        <span class="pf-hero-stat-lbl">network</span>
                        <span class="pf-hero-stat-val">@network.Buses.Count·@dcResult.BranchFlows.Count·@network.Generators.Count</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Compact DC metrics: Pg total, Pd total. Losses are zero by construction. -->
        <div class="pf-metrics pf-panel mb-3">
            <div class="pf-metric">
                <div class="pf-metric-row">
                    <span class="pf-metric-num">@Fmt(DcGenMw())</span>
                    <span class="pf-metric-unit">MW</span>
                </div>
                <div class="pf-metric-lbl">Generation</div>
            </div>
            <div class="pf-metric">
                <div class="pf-metric-row">
                    <span class="pf-metric-num">@Fmt(DcLoadMw())</span>
                    <span class="pf-metric-unit">MW</span>
                </div>
                <div class="pf-metric-lbl">Load</div>
            </div>
            <div class="pf-metric">
                <div class="pf-metric-row">
                    <span class="pf-metric-num">0.0</span>
                    <span class="pf-metric-unit">MW</span>
                </div>
                <div class="pf-metric-lbl">Losses (lossless DC)</div>
            </div>
            <div class="pf-metric">
                <div class="pf-metric-row">
                    <span class="pf-metric-num">@DcPeakAngle().ToString("F2")</span>
                    <span class="pf-metric-unit">°</span>
                </div>
                <div class="pf-metric-lbl">Max |Va|</div>
            </div>
        </div>

        <!-- DC tables: angles only, branch flows are real-power only. -->
        <div class="pf-panel mb-3">
            <div class="pf-tabs">
                <button class="pf-tab @(tab == "buses" ? "active" : "")"
                        @onclick='() => tab = "buses"'>
                    Buses <span class="pf-tab-count">@network.Buses.Count</span>
                </button>
                <button class="pf-tab @(tab == "branches" ? "active" : "")"
                        @onclick='() => tab = "branches"'>
                    Branches <span class="pf-tab-count">@dcResult.BranchFlows.Count</span>
                </button>
            </div>

            <div class="pf-tbl-wrap">
                @if (tab == "buses")
                {
                    <table class="table table-sm pf-tbl mb-0">
                        <thead><tr>
                            <th>Bus</th>
                            <th>Type</th>
                            <th class="text-end">Va (°)</th>
                            <th class="text-end">Pg (MW)</th>
                            <th class="text-end">Pd (MW)</th>
                        </tr></thead>
                        <tbody>
                            @for (int i = 0; i < network.Buses.Count; i++)
                            {
                                var bus = network.Buses[i];
                                <tr>
                                    <td>@bus.Id</td>
                                    <td><span class="pf-bus-chip pf-bus-@bus.Type.ToString().ToLowerInvariant()">@bus.Type</span></td>
                                    <td class="text-end">@dcResult.Va[i].ToString("F3")</td>
                                    <td class="text-end">@Fmt(dcResult.Pg[i] * network.BaseMva)</td>
                                    <td class="text-end">@bus.Pd.ToString("F1")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="table table-sm pf-tbl mb-0">
                        <thead><tr>
                            <th>From</th>
                            <th>To</th>
                            <th class="text-end">P (MW)</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var bf in dcResult.BranchFlows)
                            {
                                <tr>
                                    <td>@bf.FromBus</td>
                                    <td>@bf.ToBus</td>
                                    <td class="text-end">@Fmt(bf.P * network.BaseMva)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @* ── Network diagram (shared between AC and DC) ────────── *@
    @* Hoisted out of the AC-only block so the same DOM node persists across mode    *@
    @* switches. Without this, switching AC→DC→AC would unmount/remount the diagram  *@
    @* container, which intermittently crashed Cytoscape (n.className on null).      *@
    @if ((result is not null || dcResult is not null) && network is not null)
    {
        var diagBranchCount = result is not null ? result.BranchFlows.Count : (dcResult?.BranchFlows.Count ?? 0);
        var diagIsDc = dcResult is not null;
        <div class="pf-panel mb-3">
            <div class="pf-section-head">
                <span class="pf-section-title">Network Diagram</span>
                <span class="pf-section-meta">
                    @network.Buses.Count buses &thinsp;·&thinsp; @diagBranchCount branches
                    @if (diagIsDc)
                    {
                        <span class="pf-section-note">&thinsp;· DC: bus tone = |Va| deviation</span>
                    }
                    @if (network.Buses.Count > 100)
                    {
                        <span class="pf-section-note">&thinsp;· random layout for large cases</span>
                    }
                </span>
                <button class="pf-icon-btn ms-auto" @onclick="ResetZoom" title="Reset zoom">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 3 21 3 21 9"/>
                        <polyline points="9 21 3 21 3 15"/>
                        <line x1="21" y1="3" x2="14" y2="10"/>
                        <line x1="3" y1="21" x2="10" y2="14"/>
                    </svg>
                    Reset zoom
                </button>
            </div>
            @if (_diagramError is not null)
            {
                <div class="pf-banner pf-fail m-2 mt-0">@_diagramError</div>
            }
            <div class="pf-diagram-wrap">
                <div @ref="_diagramContainer" class="pf-diagram"></div>
                @if (_popover is { } p)
                {
                    <div class="pf-node-popover">
                        <div class="pf-npo-head">
                            <span class="pf-npo-title">Bus @p.BusId</span>
                            <span class="pf-bus-chip pf-bus-@p.TypeCss">@p.TypeLabel</span>
                            <button class="pf-npo-close" @onclick="ClosePopover" title="Close">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </button>
                        </div>
                        <div class="pf-npo-grid">
                            @if (p.Vm is { } vm)
                            {
                                <span class="pf-npo-lbl">Vm</span>
                                <span class="pf-npo-val @VmClass(vm)">@vm.ToString("F4") pu</span>
                            }
                            <span class="pf-npo-lbl">Va</span>
                            <span class="pf-npo-val">@p.Va.ToString("F3")°</span>
                            <span class="pf-npo-sep"></span><span class="pf-npo-sep"></span>
                            <span class="pf-npo-lbl">Pg</span>
                            <span class="pf-npo-val">@Fmt(p.Pg) MW</span>
                            @if (p.Qg is { } qg)
                            {
                                <span class="pf-npo-lbl">Qg</span>
                                <span class="pf-npo-val">@Fmt(qg) MVAr</span>
                            }
                            <span class="pf-npo-sep"></span><span class="pf-npo-sep"></span>
                            <span class="pf-npo-lbl">Pd</span>
                            <span class="pf-npo-val">@Fmt(p.Pd) MW</span>
                            @if (p.Qd is { } qd)
                            {
                                <span class="pf-npo-lbl">Qd</span>
                                <span class="pf-npo-val">@Fmt(qd) MVAr</span>
                            }
                        </div>
                    </div>
                }
                @if (_branchPopover is { } b)
                {
                    <div class="pf-node-popover">
                        <div class="pf-npo-head">
                            <span class="pf-npo-title">@b.FromBusId &thinsp;→&thinsp; @b.ToBusId</span>
                            <button class="pf-npo-close" @onclick="ClosePopover" title="Close">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </button>
                        </div>
                        <div class="pf-npo-grid">
                            <span class="pf-npo-lbl">P_ij</span>
                            <span class="pf-npo-val">@Fmt(b.Pij) MW</span>
                            @if (b.Qij is { } qij)
                            {
                                <span class="pf-npo-lbl">Q_ij</span>
                                <span class="pf-npo-val">@Fmt(qij) MVAr</span>
                            }
                            <span class="pf-npo-sep"></span><span class="pf-npo-sep"></span>
                            @if (b.Pji is { } pji)
                            {
                                <span class="pf-npo-lbl">P_ji</span>
                                <span class="pf-npo-val">@Fmt(pji) MW</span>
                            }
                            @if (b.Qji is { } qji)
                            {
                                <span class="pf-npo-lbl">Q_ji</span>
                                <span class="pf-npo-val">@Fmt(qji) MVAr</span>
                            }
                            @if (b.Qij is null && b.Pji is null)
                            {
                                <span class="pf-npo-sep"></span><span class="pf-npo-sep"></span>
                            }
                            <span class="pf-npo-sep"></span><span class="pf-npo-sep"></span>
                            @if (b.LossMW is { } loss)
                            {
                                <span class="pf-npo-lbl">Loss</span>
                                <span class="pf-npo-val">@Fmt(loss) MW</span>
                            }
                            <span class="pf-npo-lbl">Loading</span>
                            <span class="pf-npo-val @LoadClass(b.LoadingPct)">
                                @(double.IsNaN(b.LoadingPct) ? "—" : b.LoadingPct.ToString("F1") + "%")
                            </span>
                        </div>
                    </div>
                }
            </div>
            <div class="pf-legend">
                <span class="pf-legend-label">Buses</span>
                @if (diagIsDc)
                {
                    <span class="pf-legend-item">
                        <span class="pf-legend-dot" style="background:#22c55e"></span>|Va| &lt; 15°
                    </span>
                    <span class="pf-legend-item">
                        <span class="pf-legend-dot" style="background:#f59e0b"></span>15–30°
                    </span>
                    <span class="pf-legend-item">
                        <span class="pf-legend-dot" style="background:#ef4444"></span>≥ 30°
                    </span>
                }
                else
                {
                    <span class="pf-legend-item">
                        <span class="pf-legend-dot" style="background:#22c55e"></span>0.95–1.05 pu
                    </span>
                    <span class="pf-legend-item">
                        <span class="pf-legend-dot" style="background:#f59e0b"></span>Over-voltage
                    </span>
                    <span class="pf-legend-item">
                        <span class="pf-legend-dot" style="background:#ef4444"></span>Under-voltage
                    </span>
                }
                <span class="pf-legend-sep"></span>
                <span class="pf-legend-label">Branches</span>
                <span class="pf-legend-item">
                    <span class="pf-legend-line" style="background:#22c55e"></span>&lt;70%
                </span>
                <span class="pf-legend-item">
                    <span class="pf-legend-line" style="background:#f59e0b"></span>70–90%
                </span>
                <span class="pf-legend-item">
                    <span class="pf-legend-line" style="background:#ef4444"></span>≥90%
                </span>
            </div>
        </div>
    }
}

@code {
    record CaseMeta(string File, string Label, int Buses, int Branches, int Gens);

    record SolveMetrics(
        double GenMW, double LoadMW, double LossMW,
        double VmMin, double VmMax, double MaxLoadPct,
        int NSlack, int NPv, int NPq);

    // Vm/Qg/Qd are nullable so the same record serves both AC (full data) and DC
    // (no voltage magnitude or reactive power in the linearised model).
    record PopoverBus(
        int BusId, string TypeLabel, string TypeCss,
        double? Vm, double Va,
        double Pg, double? Qg,
        double Pd, double? Qd);

    // Qij/Pji/Qji/LossMW nullable for the same reason — DC reports a single
    // real-power flow per branch, with no reactive component and zero losses.
    record PopoverBranch(
        int FromBusId, int ToBusId,
        double Pij, double? Qij,
        double? Pji, double? Qji,
        double? LossMW, double LoadingPct);

    static readonly CaseMeta[] Cases =
    [
        new("case14",  "IEEE 14",   14,  20,  5),
        new("case30",  "IEEE 30",   30,  41,  6),
        new("case57",  "IEEE 57",   57,  80,  7),
        new("case118", "IEEE 118", 118, 186, 54),
        new("case300", "IEEE 300", 300, 411, 69),
    ];

    string? fileName;
    string? fileContent;
    bool busy;
    string? error;
    DcPowerFlowResult? dcResult;
    List<ValidationError> validationErrors = [];
    List<ValidationError> validationWarnings = [];

    // Solver options (mirrors NewtonRaphsonSolver init properties)
    string mode = "ac";                         // "ac" | "dc"
    bool optFlatStart = false;
    bool optEnforceLimits = true;
    bool optDistSlack = false;
    bool optWarmStart = false;
    string optToleranceStr = "1e-6";
    int optMaxIter = 50;
    string tab = "buses";
    bool logCollapsed = true;
    PowerNetwork? network;
    PowerFlowResult? result;
    List<(string Text, bool IsWarn)> logLines = [];
    ElementReference logPanel;
    bool shouldScroll;
    ElementReference _diagramContainer;
    IJSObjectReference? _diagramModule;
    bool _shouldRenderDiagram;
    string? _diagramError;
    DotNetObjectReference<Home>? _dotNetRef;
    PopoverBus? _popover;
    PopoverBranch? _branchPopover;

    SolveMetrics? _metrics;
    SolveMetrics? Metrics => _metrics ??= BuildMetrics();

    SolveMetrics? BuildMetrics()
    {
        if (result is null || network is null) return null;
        var ps = result.BranchFlows.Select(bf => bf.LoadingPct).Where(p => !double.IsNaN(p)).ToList();
        // Prefer SystemBalance from a converged solve (computed once in Core, includes losses,
        // shunts, reactive totals). Falls back to manual sums for non-converged results so the
        // bar still shows last-iteration values rather than going blank.
        var bal = result.Balance;
        return new SolveMetrics(
            GenMW:      bal?.TotalGenerationMw ?? result.Pg.Sum() * network.BaseMva,
            LoadMW:     bal?.TotalLoadMw ?? network.Buses.Sum(b => b.Pd),
            LossMW:     bal?.TotalLossesMw ?? result.BranchFlows.Sum(bf => bf.Pij + bf.Pji) * network.BaseMva,
            VmMin:      result.Vm.Min(),
            VmMax:      result.Vm.Max(),
            MaxLoadPct: ps.Count > 0 ? ps.Max() : double.NaN,
            NSlack:     network.Buses.Count(b => b.Type == BusType.Slack),
            NPv:        network.Buses.Count(b => b.Type == BusType.PV),
            NPq:        network.Buses.Count(b => b.Type == BusType.PQ));
    }

    async Task LoadSample(string caseFile)
    {
        var path = Path.Combine(Env.WebRootPath, "cases", caseFile + ".m");
        fileContent = await File.ReadAllTextAsync(path);
        fileName = caseFile + ".m";
        await Solve();
    }

    async Task HandleFile(InputFileChangeEventArgs e)
    {
        fileName = e.File.Name;
        result = null;
        error = null;
        logLines.Clear();
        using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
        fileContent = await reader.ReadToEndAsync();
    }

    async Task Solve()
    {
        if (fileContent is null) return;
        busy = true;
        error = null;
        result = null;
        dcResult = null;
        _metrics = null;
        _popover = null;
        _branchPopover = null;
        logLines.Clear();
        logCollapsed = true;
        _diagramError = null;
        validationErrors.Clear();
        validationWarnings.Clear();

        var logger = new SolverLogger(async (text, isWarn) =>
        {
            await InvokeAsync(() =>
            {
                logLines.Add((text, isWarn));
                shouldScroll = true;
                StateHasChanged();
            });
        });

        try
        {
            var net = MatpowerParser.Parse(fileContent);

            // Validate before solving — surfaces NO_SLACK_BUS, NETWORK_ISLANDED, bad refs, etc.
            // with stable error codes instead of letting the solver throw a confusing message
            // (or silently return non-converged) deep inside the NR loop.
            var validation = NetworkValidator.Validate(net);
            validationErrors = validation.Errors
                .Where(v => v.Severity == ValidationSeverity.Error).ToList();
            validationWarnings = validation.Errors
                .Where(v => v.Severity == ValidationSeverity.Warning).ToList();
            if (validationErrors.Count > 0)
                return; // workspace stays empty; the validation panel is visible

            if (mode == "dc")
            {
                // DC has no convergence loop and no init options — one sparse-LU step.
                var dc = await Task.Run(() => new DcPowerFlowSolver().Solve(net));
                network = net;
                dcResult = dc;
                _shouldRenderDiagram = true;
            }
            else
            {
                // Tolerance accepts scientific notation ("1e-6") or fixed ("0.000001"). Bad input
                // silently falls back to the MATPOWER default — surfacing that in the UI is more
                // friction than it's worth for an obvious user-typo case.
                if (!double.TryParse(optToleranceStr, NumberStyles.Float, CultureInfo.InvariantCulture, out var tol)
                    || tol <= 0)
                    tol = 1e-6;

                var solver = new NewtonRaphsonSolver
                {
                    Log              = logger,
                    Tolerance        = tol,
                    MaxIterations    = Math.Clamp(optMaxIter, 1, 500),
                    FlatStart        = optFlatStart,
                    EnforceLimits    = optEnforceLimits,
                    DistributedSlack = optDistSlack,
                    WarmStartFromDc  = optWarmStart,
                };
                var res = await Task.Run(() => solver.Solve(net));
                network = net;
                result = res;
                _shouldRenderDiagram = true;
                _metrics = null; // invalidate lazy cache so Metrics recomputes from new result/network
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    void ToggleLog() => logCollapsed = !logCollapsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldScroll && !logCollapsed)
        {
            shouldScroll = false;
            await JS.InvokeVoidAsync("scrollToBottom", logPanel);
        }
        if (_shouldRenderDiagram && network is not null && (result is not null || dcResult is not null))
        {
            _shouldRenderDiagram = false;
            try
            {
                _diagramModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./diagram.js");
                _dotNetRef ??= DotNetObjectReference.Create(this);

                object[] busData;
                object[] branchData;
                string diagMode;

                if (dcResult is not null)
                {
                    diagMode = "dc";
                    // DC: voltages are 1 pu by assumption — colour by |Va| deviation
                    // bucketed into a 0/1/2 tone the JS layer maps to green/amber/red.
                    busData = network.Buses.Select((b, i) =>
                    {
                        double absVa = Math.Abs(dcResult.Va[i]);
                        int tone = absVa >= 30 ? 2 : absVa >= 15 ? 1 : 0;
                        return (object)new { id = b.Id, vm = (double?)null, vmTone = (int?)tone, busType = (int)b.Type };
                    }).ToArray();

                    // DC branches: loading from |P|*BaseMva / RateA when RateA > 0.
                    // RateA lives on the input branch (in MVA); pair by index since
                    // DcBranchFlow keeps the order of in-service branches.
                    var inSvcBranches = network.Branches.Where(b => b.IsInService).ToList();
                    var mva = network.BaseMva;
                    branchData = dcResult.BranchFlows.Select((bf, i) =>
                    {
                        double rateA = i < inSvcBranches.Count ? inSvcBranches[i].RateA : 0.0;
                        double? pct = rateA > 0 ? Math.Abs(bf.P) * mva / rateA * 100.0 : (double?)null;
                        return (object)new { fromBusId = bf.FromBus, toBusId = bf.ToBus, loadingPct = pct };
                    }).ToArray();
                }
                else
                {
                    diagMode = "ac";
                    busData = network.Buses.Select((b, i) =>
                        (object)new { id = b.Id, vm = (double?)result!.Vm[i], vmTone = (int?)null, busType = (int)b.Type }
                    ).ToArray();
                    branchData = result!.BranchFlows.Select(bf =>
                        (object)new {
                            fromBusId = bf.FromBusId,
                            toBusId   = bf.ToBusId,
                            loadingPct = double.IsNaN(bf.LoadingPct) ? (double?)null : bf.LoadingPct
                        }
                    ).ToArray();
                }

                await _diagramModule.InvokeVoidAsync(
                    "render", _diagramContainer, busData, branchData, _dotNetRef, diagMode);
            }
            catch (Exception ex)
            {
                _diagramError = ex.Message;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task OnNodeTap(int busId)
    {
        if (network is null) return Task.CompletedTask;
        var idx = network.IndexOf(busId);
        if (idx < 0) return Task.CompletedTask;
        var bus = network.Buses[idx];
        _branchPopover = null;

        if (result is not null)
        {
            // AC: full voltage + reactive data.
            _popover = new PopoverBus(
                BusId:     busId,
                TypeLabel: bus.Type.ToString(),
                TypeCss:   bus.Type.ToString().ToLowerInvariant(),
                Vm: result.Vm[idx],
                Va: result.Va[idx],
                Pg: result.Pg[idx] * network.BaseMva,
                Qg: result.Qg[idx] * network.BaseMva,
                Pd: bus.Pd,
                Qd: bus.Qd);
        }
        else if (dcResult is not null)
        {
            // DC: angle + real-power only. Vm/Qg/Qd left null so the popover hides those rows.
            _popover = new PopoverBus(
                BusId:     busId,
                TypeLabel: bus.Type.ToString(),
                TypeCss:   bus.Type.ToString().ToLowerInvariant(),
                Vm: null,
                Va: dcResult.Va[idx],
                Pg: dcResult.Pg[idx] * network.BaseMva,
                Qg: null,
                Pd: bus.Pd,
                Qd: null);
        }
        else
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnEdgeTap(int edgeIndex)
    {
        if (network is null) return Task.CompletedTask;
        _popover = null;
        var mva = network.BaseMva;

        if (result is not null)
        {
            if (edgeIndex < 0 || edgeIndex >= result.BranchFlows.Count) return Task.CompletedTask;
            var bf = result.BranchFlows[edgeIndex];
            _branchPopover = new PopoverBranch(
                FromBusId:  bf.FromBusId,
                ToBusId:    bf.ToBusId,
                Pij:        bf.Pij * mva,
                Qij:        bf.Qij * mva,
                Pji:        bf.Pji * mva,
                Qji:        bf.Qji * mva,
                LossMW:     (bf.Pij + bf.Pji) * mva,
                LoadingPct: bf.LoadingPct);
        }
        else if (dcResult is not null)
        {
            if (edgeIndex < 0 || edgeIndex >= dcResult.BranchFlows.Count) return Task.CompletedTask;
            var bf = dcResult.BranchFlows[edgeIndex];
            // Recover loading from input branch RateA (DC has no RateA in its result type).
            var inSvcBranches = network.Branches.Where(b => b.IsInService).ToList();
            double rateA = edgeIndex < inSvcBranches.Count ? inSvcBranches[edgeIndex].RateA : 0.0;
            double pct = rateA > 0 ? Math.Abs(bf.P) * mva / rateA * 100.0 : double.NaN;
            _branchPopover = new PopoverBranch(
                FromBusId:  bf.FromBus,
                ToBusId:    bf.ToBus,
                Pij:        bf.P * mva,
                Qij:        null,    // DC: no reactive
                Pji:        null,    // DC: lossless, Pji = -Pij — omit to keep the popover compact
                Qji:        null,
                LossMW:     null,    // DC: lossless by construction
                LoadingPct: pct);
        }
        else
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnBackgroundTap()
    {
        _popover = null;
        _branchPopover = null;
        return InvokeAsync(StateHasChanged);
    }

    async Task ResetZoom()
    {
        if (_diagramModule is not null)
            try { await _diagramModule.InvokeVoidAsync("resetZoom"); } catch { }
    }

    async Task ClosePopover()
    {
        _popover = null;
        _branchPopover = null;
        if (_diagramModule is not null)
            try { await _diagramModule.InvokeVoidAsync("unselectAll"); } catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_diagramModule is not null)
            await _diagramModule.DisposeAsync();
        _dotNetRef?.Dispose();
    }

    // DC display helpers — computed inline to avoid the RZ1010 trap with @{ } in nested @if.
    double DcGenMw() => dcResult is null || network is null ? 0 : dcResult.Pg.Sum() * network.BaseMva;
    double DcLoadMw() => network is null ? 0 : network.Buses.Sum(b => b.Pd);
    double DcPeakAngle() => dcResult is null ? 0 : dcResult.Va.Length == 0 ? 0 : dcResult.Va.Max(a => Math.Abs(a));

    static string Fmt(double v) => (Math.Abs(v) < 1e-4 ? 0.0 : v).ToString("F1");
    static string VmClass(double vm) => vm < 0.95 || vm > 1.05 ? "pf-cell-warn" : "";
    static string LoadClass(double pct) => double.IsNaN(pct) ? "" : pct >= 90 ? "pf-cell-danger" : pct >= 70 ? "pf-cell-warn" : "";
    static string VoltageRangeClass(double vmMin, double vmMax) =>
        vmMin < 0.95 ? "pf-metric-danger" : vmMax > 1.05 ? "pf-metric-warn" : "";
    static string MaxLoadClass(double pct) =>
        double.IsNaN(pct) ? "" : pct >= 90 ? "pf-metric-danger" : pct >= 70 ? "pf-metric-warn" : "";

    sealed class SolverLogger(Func<string, bool, Task> emit) : ILogger
    {
        public IDisposable? BeginScope<TState>(TState state) where TState : notnull => null;
        public bool IsEnabled(LogLevel level) => true;
        public void Log<TState>(LogLevel level, EventId id, TState state, Exception? ex,
            Func<TState, Exception?, string> formatter) =>
            _ = emit(formatter(state, ex), level >= LogLevel.Warning);
    }
}
