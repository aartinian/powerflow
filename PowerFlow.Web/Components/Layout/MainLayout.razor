@inherits LayoutComponentBase

<div class="pf-shell">
    <header class="pf-topbar">
        <a class="pf-brand" href="/" aria-label="PowerFlow — home">
            <span class="pf-brand-mark" aria-hidden="true">
                @* Three-node triangle: a stylised three-phase / three-bus mark.    *@
                @* Reads as a tiny network graph — fitting for a power-flow tool.   *@
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                     stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="4" y2="19" />
                    <line x1="12" y1="5" x2="20" y2="19" />
                    <line x1="4" y1="19" x2="20" y2="19" />
                    <circle cx="12" cy="5"  r="2.4" fill="currentColor" stroke="none" />
                    <circle cx="4"  cy="19" r="2.4" fill="currentColor" stroke="none" />
                    <circle cx="20" cy="19" r="2.4" fill="currentColor" stroke="none" />
                </svg>
            </span>
            <span class="pf-brand-text">
                <span class="pf-brand-name">PowerFlow</span>
                <span class="pf-brand-tag">AC/DC steady-state solver</span>
            </span>
        </a>

        <NavMenu />

        <div class="pf-topbar-end">
            <span class="pf-topbar-version" title="Library version">v1.0</span>

            <a class="pf-topbar-link"
               href="https://github.com/aartinian/powerflow"
               target="_blank" rel="noopener noreferrer"
               title="View source on GitHub" aria-label="GitHub">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.69-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.07.78 2.16 0 1.56-.01 2.81-.01 3.19 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
                </svg>
                <span>GitHub</span>
            </a>

            <button class="pf-theme-toggle" onclick="pfToggleTheme()"
                    title="Toggle dark / light mode" aria-label="Toggle dark mode">
                <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"/>
                    <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
                <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
            </button>
        </div>
    </header>

    <main class="pf-main">
        <div class="pf-content">
            @Body
        </div>
    </main>

    <footer class="pf-footer">
        <div class="pf-footer-inner">
            <div class="pf-footer-attr">
                Built by <strong>aart</strong>
                <span class="pf-footer-sep" aria-hidden="true">·</span>
                <a href="https://github.com/aartinian/powerflow"
                   target="_blank" rel="noopener noreferrer">github.com/aartinian/powerflow</a>
            </div>
            <div class="pf-footer-stack" aria-label="Tech stack">
                <span class="pf-footer-chip">C# · .NET 10</span>
                <span class="pf-footer-chip">Blazor Server</span>
                <span class="pf-footer-chip">CSparse (sparse LU)</span>
                <span class="pf-footer-chip">Cytoscape.js</span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
